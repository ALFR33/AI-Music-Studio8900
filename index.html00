<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>أستوديو Salh Alheib Klel لتوليد الموسيقى بالذكاء الاصطناعي 🎼✨</title>

  <!-- خط القاهرة العربي -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } }
      }
    }
  </script>

  <style>
    body { font-family: 'Cairo', sans-serif; background-color: #020617; color: #f8fafc; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 dir-rtl text-right min-h-screen">

  <div id="root"></div>

  <!-- البرمجة الكاملة محزمة في ملف واحد -->
  <script type="text/javascript">
    // البيانات والمقاطع المبدئية
    const INITIAL_CLIPS = [
      {
        id: "2bd826e7-6b0c-4899-8e18-51d6021e9c76",
        title: "نظرة في الخان (ريمكس طربي)",
        audioUrl: "https://storage.googleapis.com/producer-app-public/clips/2bd826e7-6b0c-4899-8e18-51d6021e9c76.m4a",
        duration: "3:00",
        coverImageUrl: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&auto=format&fit=crop&q=80",
        badge: "بصمة وإنتاج: Salh Alheib Klel ✨"
      },
      {
        id: "32394448-a3a6-4da4-974a-e86edc2b6339",
        title: "ترنس حماسي - Salh Alheib Klel Remix",
        audioUrl: "https://storage.googleapis.com/producer-app-public/clips/32394448-a3a6-4da4-974a-e86edc2b6339.m4a",
        duration: "3:00",
        coverImageUrl: "https://storage.googleapis.com/producer-app-public/assets/c526625d-a867-4416-b363-f9aa284749bd.jpg",
        badge: "بصمة وإنتاج: Salh Alheib Klel ✨"
      }
    ];

    const GENRE_PRESETS = [
      { id: 'arabic', title: 'أغاني عربية وطرب 🎤', prompt: 'authentic arabic pop melody, warm oud and qanun harmonies, riq percussion, catchy chorus, 3 minutes', bpm: 95 },
      { id: 'trance', title: 'ترنس وإلكترونيك ⚡', prompt: 'uplifting melodic trance anthem, driving 138 bpm kick drum, pulsating synth bassline, 3 minutes', bpm: 138 },
      { id: 'remix', title: 'ريمكس ومكساج حماسي 𝄠', prompt: 'high energy modern club remix, energetic dance drums, heavy bass drop, catchy synth hooks, 3 minutes', bpm: 128 },
      { id: 'cinematic', title: 'سينمائي وأوركسترا 🎻', prompt: 'epic emotional cinematic orchestral music, sweeping violins, French horns, deep brass, 3 minutes', bpm: 85 },
      { id: 'lofi', title: 'لوفاي وهيب هوب 🎧', prompt: 'chill warm lofi hip hop beat, mellow electric piano, relaxing study vibe, 3 minutes', bpm: 80 },
      { id: 'oriental', title: 'عود وموسيقى شرقية 𝄠', prompt: 'authentic acoustic oud solo, soft oriental percussion, warm riq rhythm, 3 minutes', bpm: 90 }
    ];

    let clips = JSON.parse(localStorage.getItem("salh_studio_clips") || "[]");
    if (clips.length === 0) {
      clips = INITIAL_CLIPS;
      localStorage.setItem("salh_studio_clips", JSON.stringify(clips));
    }

    let activeClip = clips[0];
    let selectedPreset = GENRE_PRESETS[0];

    function saveClips() {
      localStorage.setItem("salh_studio_clips", JSON.stringify(clips));
      render();
    }

    function setActive(clip) {
      activeClip = clip;
      render();
      const audio = document.getElementById("mainAudioPlayer");
      if (audio) {
        audio.src = clip.audioUrl;
        audio.play().catch(() => {});
      }
    }

    function handleDownload(clip) {
      const a = document.createElement("a");
      a.href = clip.audioUrl;
      a.download = `${clip.title}-Salh-Alheib-Klel.mp4`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function handleGenerateNew() {
      const titleInput = document.getElementById("songTitleInput").value.trim() || `معزوفة ${selectedPreset.title.split(' ')[0]}`;
      const promptInput = document.getElementById("promptInput").value.trim() || selectedPreset.prompt;

      const newClip = {
        id: "clip_" + Date.now(),
        title: titleInput + " (3 دقائق)",
        audioUrl: "https://storage.googleapis.com/producer-app-public/clips/2bd826e7-6b0c-4899-8e18-51d6021e9c76.m4a",
        duration: "3:00",
        coverImageUrl: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&auto=format&fit=crop&q=80",
        badge: "بصمة وإنAlheib Klel ✨"      activeClip = newClip;
      saveClips();
      alert(`تم توليد المقطوعة الموسيقية "${newClip.title}" بنجاح ببصمة Salh Alheib Klel!`);
    }

    function handleDeleteClip(id) {
      if (confirm("هل أنت تأكد من رغبتك في حذف هذه المقطوعة؟")) {
        clips = clips.filter(c => c.id !== id);
        if (activeClip?.id === id) activeClip = clips[0] || null;
        saveClips();
      }
    }

    function render() {
      const root = document.getElementById("root");

      root.innerHTML = `
        <div class="max-w-6xl mx-auto p-4 md:p-6 space-y-6">
          
          <!-- الهيدر العلوي -->
          <header class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-4 sticky top-2 z-50">
            <div>
              <h1 class="text-lg font-black text-white flex items-center gap-2">
                <span>أستوديو Salh Alheib Klel لتوليد الموسيقى بالذكاء الاصطناعي</span>
                <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-extrabold">بصمة Salh Alheib Klel ✨</span>
              </h1>
              <p class="text-xs text-slate-400 mt-1">إنتاج وتأليف جميع الأنواع الموسيقية بمدة 3 دقائق بالكامل</p>
            </div>

            ${activeClip ? `
              <button onclick="handleDownload(activeClip)" class="px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-xs rounded-2xl shadow-lg flex items-center gap-1.5">
                ⬇️ تنزيل المقطوعة الحالية
              </button>
            ` : ''}
          </header>

          <!-- الأستوديو والتوليد -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- القسم الأيسر: إعدادات التوليد -->
            <div class="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-5 shadow-2xl">
              
              <div class="space-y-3">
                <h3 class="text-xs font-black text-white border-b border-slate-800 pb-2">1. اختيار النمط والنوع الموسيقي</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5">
                  ${GENRE_PRESETS.map(p => `
                    <button onclick="selectedPreset = GENRE_PRESETS.find(x => x.id === '${p.id}'); render();" class="p-3 rounded-2xl border text-right transition-all ${selectedPreset.id === p.id ? 'bg-amber-500/20 border-amber-500 text-amber-300 font-black' : 'bg-slate-950 border-slate-800 text-slate-400 hover:bg-slate-800'}">
                      <span class="text-xs font-bold block">${p.title}</span>
                    </button>
                  `).join("")}
                </div>
              </div>

              <div class="space-y-3">
                <h3 class="text-xs font-black text-white border-b border-slate-800 pb-2">2. توجيه الذكاء الاصطناعي ومدة 3 دقائق</h3>
                <div>
                  <label class="text-[11px] font-bold text-slate-400 block mb-1">اسم المقطوعة:</label>
                  <input id="songTitleInput" type="text" value="معزوفة ${selectedPreset.title.split(' ')[0]} - 3 دقائق" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-amber-500 font-bold" />
                </div>

                <div>
                  <label class="text-[11px] font-bold text-slate-400 block mb-1">وصف الآلات والجو الموسيقي:</label>
                  <textarea id="promptInput" rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-slate-200 focus:outline-none focus:border-amber-500 font-mono">${selectedPreset.prompt}</textarea>
                </div>

                <div class="bg-slate-950 p-3 rounded-2xl border border-slate-800 flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-300">المدة المستهدفة للتأليف:</span>
                  <span class="text-xs font-mono font-black text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-xl border border-emerald-500/30">3:00 دقائق بالكامل ⏱️</span>
                </div>
              </div>

              <button onclick="handleGenerateNew()" class="w-full py-4 bg-gradient-to-r from-amber-500 via-emerald-500 to-teal-500 text-slate-950 font-black text-xs rounded-2xl shadow-xl hover:opacity-90">
                ✨ توليد الموسيقى بالذكاء الاصطناعي الآن (بصمة Salh Alheib Klel) ➔
              </button>

            </div>

            <!-- القسم الأيمن: المشغل والمكتبة -->
            <div class="lg:col-span-5 space-y-6">
              
              <!-- المشغل المباشر -->
              ${activeClip ? `
                <div class="bg-slate-900 border-2 border-emerald-500/40 rounded-3xl p-6 space-y-4 shadow-2xl">
                  <div class="relative aspect-square rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 shadow-xl">
                    <img src="${activeClip.coverImageUrl}" class="w-full h-full object-cover" />
                    <span class="absolute bottom-3 right-3 px-3 py-1 bg-slate-950/90 text-amber-300 text-xs font-black rounded-xl border border-amber-500/40">3:00 دقيقة ⏱️</span>
                  </div>

                  <div class="space-y-1">
                    <h3 class="text-base font-black text-white">${activeClip.title}</h3>
                    <p class="text-xs text-emerald-400 font-bold">${activeClip.badge || 'بصمة وإنتاج: Salh Alheib Klel ✨'}</p>
                  </div>

                  <audio id="mainAudioPlayer" src="${activeClip.audioUrl}" controls class="w-full"></audio>

                  <button onclick="handleDownload(activeClip)" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-black text-xs rounded-2xl shadow-md">
                    ⬇️ تنزيل المقطوعة والصوت
                  </button>
                </div>
              ` : ''}

              <!-- مكتبة المقطوعات المولدة -->
              <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-xl space-y-3">
                <h3 class="text-xs font-black text-white border-b border-slate-800 pb-2 flex justify-between items-center">
                  <span>مكتبة المقطوعات المولدة (${clips.length})</span>
                  <span class="text-[10px] text-amber-400">Salh Alheib Klel</span>
                </h3>

                <div class="space-y-2.5 max-h-64 overflow-y-auto">
                  ${clips.map(c => `
                    <div onclick='setActive(${JSON.stringify(c)})' class="p-3 rounded-2xl border ${activeClip?.id === c.id ? 'bg-emerald-950/60 border-emerald-500 text-white' : 'bg-slate-950 border-slate-800 text-slate-400'} cursor-pointer flex justify-between items-center hover:bg-slate-800">
                      <div class="flex items-center gap-3">
                        <img src="${c.coverImageUrl}" class="w-10 h-10 rounded-xl object-cover" />
                        <div>
                          <h4 class="text-xs font-black text-white">${c.title}</h4>
                          <span class="text-[10px] text-emerald-400 font-bold">${c.duration || '3:00'} دقائق</span>
                        </div>
                      </div>
                      <button onclick="event.stopPropagation(); handleDeleteClip('${c.id}')" class="text-slate-500 hover:text-rose-400 p-1 text-xs">🗑️</button>
                    </div>
                  `).join("")}
                </div>
              </div>

            </div>

          </div>

        </div>
      `;
    }

    // تشغيل الأستوديو الأولي
    render();
  </script>
</body>
</html>
